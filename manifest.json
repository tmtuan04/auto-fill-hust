{
  "manifest_version": 3,
  "name": "Auto Fill Form HUST",
  "version": "5.0",
  "description": "Auto fill Quy chế kỳ 2026.1 - làm bởi Từ Minh Tuân",
  "icons": {
    "16": "images/icon.png",
    "48": "images/icon.png",
    "128": "images/icon.png"
  },
  "action": {
    "default_icon": "images/icon.png",
    "default_title": "Auto Fill Quy chế 2026.1",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://forms.office.com/*/*",
        "https://forms.cloud.microsoft/*/*"
      ],
      "js": ["scripts/content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab"]
}
